# CropCompass — unified environment template
# Copy to .env and fill in secrets before running docker compose up.
# Lines marked [required] have no safe default and must be set explicitly.
# All other lines can be left at their defaults for local development.

# =============================================================================
# Shared PostgreSQL  (used by: db, db-mcp, vector-mcp, api, agent)
# =============================================================================
POSTGRES_DB=cropcompass
POSTGRES_USER=cropcompass
POSTGRES_PASSWORD=cropcompass_secret          # [required in production]

# Full connection URLs — used by services that run outside Docker.
# Inside Docker, these are derived from POSTGRES_* by docker-compose.
DATABASE_URL=postgresql+asyncpg://cropcompass:cropcompass_secret@localhost:5432/cropcompass
DATABASE_URL_SYNC=postgresql+psycopg2://cropcompass:cropcompass_secret@localhost:5432/cropcompass

# =============================================================================
# Agent service  (port 8001)
# =============================================================================

# LLM backend: "anthropic" (cloud) or "lm_studio" (local, no cost)
LLM_BACKEND=lm_studio

# -- Anthropic (set LLM_BACKEND=anthropic to use) ----------------------------
ANTHROPIC_API_KEY=                            # [required if LLM_BACKEND=anthropic]
ANTHROPIC_BASE_URL=https://api.anthropic.com
LLM_MODEL=claude-sonnet-4-6

# -- LM Studio (set LLM_BACKEND=lm_studio to use) ----------------------------
# 1. Download LM Studio: https://lmstudio.ai
# 2. Load a model that supports tool/function calling
#    (e.g. qwen/qwen3-coder-30b, Qwen2.5-7B-Instruct, Llama-3.1-8B-Instruct)
# 3. Enable the local server (default port 1234)
# 4. IMPORTANT: copy the EXACT model identifier from the LM Studio UI / from
#    `curl http://localhost:1234/v1/models` and paste it below. A wrong/placeholder
#    id (e.g. "local-model") makes LM Studio return HTTP 400.
# 5. Set LLM_BACKEND=lm_studio
LM_STUDIO_BASE_URL=http://localhost:1234
LM_STUDIO_MODEL=qwen/qwen3-coder-30b

# -- Session storage ----------------------------------------------------------
# "postgres" = persisted across restarts (default in Docker)
# "memory"   = lost on restart (useful for quick local testing)
SESSION_BACKEND=postgres

# -- MCP servers (comma-separated; set automatically by docker-compose) -------
MCP_SERVER_URLS=http://localhost:9101,http://localhost:9102

# -- Agent tuning -------------------------------------------------------------
MAX_PLANNER_ITERATIONS=6
MCP_REQUEST_TIMEOUT_S=15.0

# -- RAG / translation models (Shanu/RAG branch) ------------------------------
INDIC_EN_MODEL=ai4bharat/indictrans2-indic-en-1B   # Indic → English (query normalisation)
EN_INDIC_MODEL=ai4bharat/indictrans2-en-indic-1B   # English → Indic (response translation)

# =============================================================================
# IMD API service  (port 8000)
# =============================================================================

# URL the API uses to proxy /api/chat → agent service
# Inside Docker this is http://agent:8001; for local dev point at the agent port
AGENT_SERVICE_URL=http://localhost:8001

# HuggingFace — used by translation service if IndicTrans2 is served remotely
HF_API_KEY=
HF_INFERENCE_ENDPOINT=https://api-inference.huggingface.co/models/ai4bharat/indictrans2-en-indic-1B

# -- IMD scraper schedule (IST, APScheduler cron) ----------------------------
IMD_GKMS_BASE_URL=https://mausam.imd.gov.in/responsive/agromet_adv_ser_district_current_en.php
IMD_SCRAPER_CRON_HOUR=6
IMD_SCRAPER_CRON_MINUTE=0
IMD_SCRAPER_TIMEZONE=Asia/Kolkata
IMD_SCRAPER_REQUEST_TIMEOUT=30     # seconds per district request
IMD_SCRAPER_CONCURRENCY=5          # concurrent district fetches
IMD_DEV_MOCK=false                 # set true to skip live IMD requests in dev

# -- Staleness thresholds -----------------------------------------------------
IMD_STALENESS_HOURS=48
FARMER_STALENESS_DAYS=90
ICAR_STALENESS_DAYS=180

# =============================================================================
# Shared  (read by both api and agent)
# =============================================================================
LOG_LEVEL=INFO

# ── Session storage ───────────────────────────────────────────────────────────
# memory = lost on restart | postgres = persisted (default in Docker)
SESSION_BACKEND=postgres
DATABASE_URL=postgresql://cropcompass:cropcompass_secret@localhost:5432/cropcompass

# ── MCP servers ───────────────────────────────────────────────────────────────
# Comma-separated base URLs the agent auto-discovers tools from on startup.
# Docker default (set in docker-compose.yml): http://db-mcp:9101,http://chroma-mcp:9103
# For a local (non-Docker) run, point at localhost:
MCP_SERVER_URLS=http://localhost:9101,http://localhost:9103
MCP_REQUEST_TIMEOUT_S=15

# ── ChromaDB knowledge store ──────────────────────────────────────────────────
# The chroma-mcp talks to a standalone ChromaDB container over HTTP.
#   HTTP mode  (Docker / production): set CHROMA_HOST (+ CHROMA_PORT).
#   Embedded   (local dev only):      leave CHROMA_HOST empty -> uses CHROMA_PATH.
CHROMA_HOST=chroma
CHROMA_PORT=8000
# Embedded-mode store path (only used when CHROMA_HOST is empty).
CHROMA_PATH=data/chromadb
# Multilingual embedder — MUST match the model the store was built with.
# In Docker this model is BAKED into the chroma-mcp image at build time and the
# container runs fully offline (HF_HUB_OFFLINE=1), so no HuggingFace access is
# needed at runtime. For a local (non-Docker) run it's fetched/cached from HF.
CHROMA_EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Collections inside the store (English-first, with Tamil fallback).
CHROMA_PRIMARY_COLLECTION=icar_knowledge_en
CHROMA_FALLBACK_COLLECTION=icar_knowledge

# ── Agent service ─────────────────────────────────────────────────────────────
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8000
ALLOWED_ORIGINS=*
# Max planner tool-use iterations before the loop gives up.
MAX_PLANNER_ITERATIONS=6

# =============================================================================
# Frontend  (ui/.env — Vite; VITE_* vars only)
# =============================================================================
# Copy these into ui/.env (not this file — Vite only reads ui/.env).
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8001
VITE_USE_MOCK=false
